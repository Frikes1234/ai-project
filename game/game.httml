<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Протокол: Артем</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#071018;font-family:Arial,sans-serif}body{display:flex;align-items:center;justify-content:center}#game{position:relative;width:min(100vw,1400px);height:min(100vh,800px);overflow:hidden;border:2px solid #263846;background:#101820}canvas{display:block;width:100%;height:100%}#hud{position:absolute;top:16px;left:16px;display:flex;gap:10px;z-index:5}.box{padding:9px 12px;border:1px solid #3c7180;border-radius:8px;background:#061018cc;color:#fff}.box span{margin-left:5px}#msg{position:absolute;top:80px;left:50%;transform:translateX(-50%);color:white;font-size:22px;font-weight:bold;text-shadow:0 2px 5px #000;opacity:0;z-index:6}#controls{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);color:#dff8ff;background:#0009;padding:8px 14px;border-radius:8px;font-size:13px;z-index:5;white-space:nowrap}#controls b{color:#6de7ff}.screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#02080ed9;color:white;text-align:center;z-index:20}.hidden{display:none!important}h1{font-size:clamp(32px,5vw,64px);margin:0 0 12px;letter-spacing:3px}p{color:#b8cbd2;margin:0 0 28px}button{border:0;border-radius:8px;padding:14px 28px;background:#36bce8;color:#061018;font-weight:bold;font-size:16px;cursor:pointer}
</style>
</head>
<body>
<div id="game">
<canvas id="c"></canvas>
<div id="hud">
<div class="box">ЭНЕРГИЯ: <span id="energy">❤️❤️❤️</span></div>
<div class="box">УРОВЕНЬ: <span id="lvl">1</span></div>
<div class="box">МИКРОЧИПЫ: <span id="chips">0</span>/15</div>
</div>
<div id="msg"></div>
<div id="controls"><b>W</b> — прыжок / Wall Jump &nbsp; <b>A</b> — влево &nbsp; <b>D</b> — вправо</div>
<div id="start" class="screen"><h1>ПРОТОКОЛ: АРТЕМ</h1><p>Секретная лаборатория</p><button>НАЧАТЬ ИГРУ</button></div>
<div id="complete" class="screen hidden"><h1>УРОВЕНЬ ПРОЙДЕН!</h1><button>СЛЕДУЮЩИЙ УРОВЕНЬ</button></div>
<div id="finish" class="screen hidden"><h1>ПОБЕГ ЗАВЕРШЁН!</h1><p>Артем выбрался из лаборатории.</p><button>ИГРАТЬ СНОВА</button></div>
</div>
<script>
const C=document.getElementById("c"),X=C.getContext("2d"),W=1400,H=800;
C.width=W;C.height=H;

// Создаем заглушки для персонажа
function createPlayerSprite() {
    const canvas = document.createElement('canvas');
    canvas.width = 62;
    canvas.height = 117;
    const ctx = canvas.getContext('2d');
    
    // Тело (синий комбинезон)
    ctx.fillStyle = '#4682b4';
    ctx.fillRect(15, 35, 32, 55);
    
    // Голова
    ctx.fillStyle = '#ffcc99';
    ctx.fillRect(10, 0, 42, 40);
    
    // Волосы
    ctx.fillStyle = '#8B4513';
    ctx.fillRect(10, 0, 42, 10);
    
    // Глаза
    ctx.fillStyle = '#000';
    ctx.fillRect(20, 15, 8, 8);
    ctx.fillRect(34, 15, 8, 8);
    
    // Рот
    ctx.fillStyle = '#ff6666';
    ctx.fillRect(25, 30, 12, 3);
    
    // Ноги
    ctx.fillStyle = '#333';
    ctx.fillRect(15, 90, 12, 27);
    ctx.fillRect(35, 90, 12, 27);
    
    // Ботинки
    ctx.fillStyle = '#222';
    ctx.fillRect(13, 112, 16, 5);
    ctx.fillRect(33, 112, 16, 5);
    
    // Руки
    ctx.fillStyle = '#4682b4';
    ctx.fillRect(5, 35, 10, 30);
    ctx.fillRect(47, 35, 10, 30);
    
    // Перчатки
    ctx.fillStyle = '#ffcc99';
    ctx.fillRect(5, 65, 10, 5);
    ctx.fillRect(47, 65, 10, 5);
    
    return canvas;
}

function createGuardSprite() {
    const canvas = document.createElement('canvas');
    canvas.width = 130;
    canvas.height = 140;
    const ctx = canvas.getContext('2d');
    
    // Тело робота
    ctx.fillStyle = '#d4d6d1';
    ctx.fillRect(25, 30, 80, 80);
    
    // Голова робота
    ctx.fillStyle = '#30373c';
    ctx.beginPath();
    ctx.arc(65, 45, 30, 0, Math.PI * 2);
    ctx.fill();
    
    // Красный глаз
    ctx.fillStyle = '#ff3b3b';
    ctx.shadowColor = '#ff3b3b';
    ctx.shadowBlur = 20;
    ctx.beginPath();
    ctx.arc(65, 45, 12, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    
    // Ноги робота
    ctx.fillStyle = '#888';
    ctx.fillRect(35, 110, 20, 30);
    ctx.fillRect(75, 110, 20, 30);
    
    // Руки-пушки
    ctx.fillStyle = '#666';
    ctx.fillRect(5, 40, 20, 15);
    ctx.fillRect(105, 40, 20, 15);
    
    return canvas;
}

function createBackground(color1, color2) {
    const canvas = document.createElement('canvas');
    canvas.width = 1400;
    canvas.height = 800;
    const ctx = canvas.getContext('2d');
    
    // Градиент фона
    const gradient = ctx.createLinearGradient(0, 0, 0, 800);
    gradient.addColorStop(0, color1);
    gradient.addColorStop(1, color2);
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 1400, 800);
    
    // Добавляем лабораторные детали
    ctx.fillStyle = 'rgba(255,255,255,0.05)';
    for(let i = 0; i < 30; i++) {
        ctx.fillRect(Math.random() * 1400, Math.random() * 800, 100, 2);
    }
    
    // Добавляем светящиеся элементы
    ctx.fillStyle = 'rgba(100,200,255,0.1)';
    for(let i = 0; i < 15; i++) {
        ctx.beginPath();
        ctx.arc(Math.random() * 1400, Math.random() * 800, 20, 0, Math.PI * 2);
        ctx.fill();
    }
    
    return canvas;
}

// Создаем спрайты
const im = {
    player: createPlayerSprite(),
    guard: createGuardSprite(),
    bg1: createBackground('#1a3a4a', '#0a1520'),
    bg2: createBackground('#2a1a3a', '#150a20'),
    bg3: createBackground('#1a3a2a', '#0a2015')
};

// Аудио система
const AudioSystem = {
    backgroundMusic: null,
    chipSound: null,
    jumpSound: null,
    isMusicPlaying: false,
    
    init() {
        this.backgroundMusic = new Audio("https://bright-magenta-0j1m8efv.edgeone.dev/");
        this.backgroundMusic.loop = true;
        this.backgroundMusic.volume = 0.3;
        
        this.chipSound = new Audio("https://appropriate-cyan-k1w3lwbp.edgeone.dev/");
        this.chipSound.volume = 0.5;
        
        this.jumpSound = new Audio("https://miserable-orange-dsukw2c2.edgeone.dev/");
        this.jumpSound.volume = 0.4;
    },
    
    startBackgroundMusic() {
        if (this.backgroundMusic && !this.isMusicPlaying) {
            this.backgroundMusic.play().catch(err => {
                console.log("Music autoplay blocked");
            });
            this.isMusicPlaying = true;
        }
    },
    
    stopBackgroundMusic() {
        if (this.backgroundMusic && this.isMusicPlaying) {
            this.backgroundMusic.pause();
            this.backgroundMusic.currentTime = 0;
            this.isMusicPlaying = false;
        }
    },
    
    playChipSound() {
        if (this.chipSound) {
            this.chipSound.currentTime = 0;
            this.chipSound.play().catch(err => {});
        }
    },
    
    playJumpSound() {
        if (this.jumpSound) {
            this.jumpSound.currentTime = 0;
            this.jumpSound.play().catch(err => {});
        }
    }
};

AudioSystem.init();

const levels=[
{w:5000,bg:"bg1",spawn:[100,500],exit:[4700,570,80,150],p:[[0,680,900,120],[1050,600,350,40],[1500,500,250,40],[1850,680,500,120],[2450,680,700,120],[2550,500,60,180],[2850,350,60,330],[3100,270,300,40],[3450,680,600,120],[4150,570,400,40],[4550,680,450,120]],h:[[900,740,150,60],[2350,740,100,60],[4050,740,100,60]],chips:[[1250,550],[1600,450],[2750,450],[3250,220],[4350,520]],boss:{x:3650,y:560,w:130,h:120,hp:3,vx:1.2,active:true}},
{w:5500,bg:"bg2",spawn:[100,500],exit:[5200,570,80,150],p:[[0,680,1000,120],[1150,570,250,40],[1500,450,220,40],[1800,570,350,40],[2250,680,400,120],[2700,550,60,250],[3000,350,60,450],[3250,280,350,40],[3700,680,600,120],[4400,560,300,40],[4800,450,300,40],[5100,680,400,120]],h:[[1000,740,150,60],[2150,740,100,60],[3600,740,100,60],[4300,740,100,60]],chips:[[1250,520],[1600,400],[2800,500],[3400,230],[4950,400]]},
{w:6000,bg:"bg3",spawn:[100,500],exit:[5700,570,100,150],p:[[0,680,900,120],[1000,570,300,40],[1400,450,250,40],[1750,680,400,120],[2250,680,700,120],[2350,480,60,200],[2650,320,60,360],[2900,200,60,480],[3100,200,400,40],[3600,680,500,120],[4200,550,300,40],[4600,430,250,40],[4950,550,350,40],[5350,680,700,120]],h:[[900,740,100,60],[1650,740,100,60],[2150,740,100,60],[4100,740,100,60],[5300,740,50,60]],chips:[[1100,520],[1500,400],[2500,420],[3000,150],[4750,380]]}
];

let L=levels[0],level=1,energy=3,totalChips=0,cam=0,playing=false,checkpoint=[100,500],msgT=0,keys={a:0,d:0,w:0},wp=0;
const P={x:100,y:500,w:62,h:92,vx:0,vy:0,ground:false,left:false,right:false,dir:1,sprite:"idle",inv:0,wall:0};

function load(n){
    level=n;
    L=levels[n-1];
    P.x=L.spawn[0];
    P.y=L.spawn[1];
    P.vx=P.vy=0;
    energy=3;
    checkpoint=[...L.spawn];
    cam=0;
    if(L.boss){
        L.boss.hp=3;
        L.boss.active=true;
        L.boss.vx=1.2;
    }
    document.getElementById("lvl").textContent=n;
    hud();
}

function hud(){
    document.getElementById("energy").textContent="❤️".repeat(energy)+"🖤".repeat(3-energy);
    document.getElementById("chips").textContent=totalChips;
}

function overlap(a,b){
    return a.x<b[0]+b[2]&&a.x+a.w>b[0]&&a.y<b[1]+b[3]&&a.y+a.h>b[1];
}

function walls(){
    P.left=P.right=false;
    for(const p of L.p){
        if(P.y+P.h>p[1]+5&&P.y<p[1]+p[3]-5){
            if(Math.abs(P.x-(p[0]+p[2]))<8)P.left=true;
            if(Math.abs(P.x+P.w-p[0])<8)P.right=true;
        }
    }
}

function hurt(t){
    if(P.inv)return;
    energy--;
    P.inv=70;
    hud();
    say(t);
    setTimeout(()=>{
        P.x=checkpoint[0];
        P.y=checkpoint[1];
        P.vx=P.vy=0;
        if(energy<=0)energy=3;
        hud();
    },180);
}

function update(){
    if(!playing)return;
    if(P.inv)P.inv--;
    
    // Движение
    if(keys.a){
        P.vx-=.45;
        P.dir=-1;
        P.sprite="run";
    }
    if(keys.d){
        P.vx+=.45;
        P.dir=1;
        P.sprite="run";
    }
    if(!keys.a&&!keys.d)P.vx*=.78;
    P.vx=Math.max(-4.5,Math.min(4.5,P.vx));
    
    // Гравитация
    P.vy=Math.min(14,P.vy+.55);
    walls();
    
    // Прыжок
    if(wp){
        if(P.ground){
            P.vy=-12;
            P.ground=false;
            P.sprite="jump";
            AudioSystem.playJumpSound();
        }else if(P.left||P.right){
            P.vx=P.left?7:-7;
            P.vy=-12;
            P.dir=P.left?1:-1;
            P.wall=12;
            P.sprite="wall";
            AudioSystem.playJumpSound();
        }
    }
    wp=0;
    if(P.wall)P.wall--;
    
    // Горизонтальное движение
    P.x+=P.vx;
    for(const p of L.p){
        if(overlap(P,p)){
            if(P.vx>0)P.x=p[0]-P.w;
            else if(P.vx<0)P.x=p[0]+p[2];
            P.vx=0;
        }
    }
    
    // Вертикальное движение
    P.y+=P.vy;
    P.ground=false;
    for(const p of L.p){
        if(overlap(P,p)){
            if(P.vy>0){
                P.y=p[1]-P.h;
                P.vy=0;
                P.ground=true;
            }else if(P.vy<0){
                P.y=p[1]+p[3];
                P.vy=0;
            }
        }
    }
    walls();
    
    if(P.ground&&!keys.a&&!keys.d)P.sprite="idle";
    if(!P.ground&&!P.wall)P.sprite="jump";
    
    // Падение
    if(P.y>900)hurt("ПАДЕНИЕ!");
    if(P.x<0)P.x=0;
    if(P.x>L.w-P.w)P.x=L.w-P.w;
    
    // Сбор чипов
    for(let i=L.chips.length-1;i>=0;i--){
        let q=L.chips[i],
            dx=P.x+P.w/2-q[0],
            dy=P.y+P.h/2-q[1];
        if(Math.hypot(dx,dy)<55){
            L.chips.splice(i,1);
            totalChips++;
            hud();
            say("+1 МИКРОЧИП");
            AudioSystem.playChipSound();
        }
    }
    
    // Чекпоинты
    if(P.x>2000&&level===1)checkpoint=[1900,550];
    if(P.x>3000&&level===2)checkpoint=[3000,250];
    if(P.x>3500&&level===3)checkpoint=[3600,550];
    
    // Опасные зоны
    for(const h of L.h){
        if(overlap(P,h))hurt("ОПАСНАЯ ЗОНА!");
    }
    
    // Босс
    if(L.boss&&L.boss.active){
        let b=L.boss;
        b.x+=b.vx||1.2;
        if(b.x>3950)b.vx=-1.2;
        if(b.x<3500)b.vx=1.2;
        
        if(P.x<b.x+b.w&&P.x+P.w>b.x&&P.y<b.y+b.h&&P.y+P.h>b.y){
            hurt("СТРАЖ АТАКУЕТ!");
        }
        
        if(P.x>3350&&P.x<3500)b.hp-=.01;
        if(b.hp<=0){
            b.active=false;
            say("СТРАЖ ОТКЛЮЧЁН!");
            checkpoint=[4100,470];
        }
    }
    
    // Выход
    let e=L.exit;
    if(P.x+P.w>e[0]&&P.x<e[0]+e[2]&&P.y+P.h>e[1]){
        if(level<3){
            document.getElementById("complete").classList.remove("hidden");
        }else{
            document.getElementById("finish").classList.remove("hidden");
        }
        playing=false;
        AudioSystem.stopBackgroundMusic();
    }
    
    // Камера
    cam+=(P.x-W*.35-cam)*.08;
    cam=Math.max(0,Math.min(L.w-W,cam));
    
    if(msgT&&!--msgT)document.getElementById("msg").style.opacity=0;
}

function draw(){
    X.clearRect(0,0,W,H);
    
    // Фон
    let bg=im[L.bg];
    if(bg){
        X.drawImage(bg, -cam * 0.25, 0, W * 1.35, H);
    } else {
        X.fillStyle="#101820";
        X.fillRect(0,0,W,H);
    }
    
    // Платформы
    for(const p of L.p){
        let x=p[0]-cam;
        X.fillStyle="#26343d";
        X.fillRect(x,p[1],p[2],p[3]);
        X.fillStyle="#4d6873";
        X.fillRect(x,p[1],p[2],7);
    }
    
    // Опасные зоны
    for(const h of L.h){
        let x=h[0]-cam;
        X.fillStyle="#dc3648";
        X.fillRect(x,h[1],h[2],h[3]);
    }
    
    // Чипы
    for(const q of L.chips){
        X.fillStyle="#53dcff";
        X.shadowColor="#53dcff";
        X.shadowBlur=18;
        X.fillRect(q[0]-cam-10,q[1]-10,20,20);
        X.shadowBlur=0;
    }
    
    // Выход
    let e=L.exit,
        x=e[0]-cam;
    X.strokeStyle="#54e6ff";
    X.lineWidth=5;
    X.strokeRect(x,e[1],e[2],e[3]);
    X.fillStyle="#54e6ff";
    X.fillRect(x+15,e[1]+20,50,8);
    
    // Босс
    if(L.boss&&L.boss.active){
        let b=L.boss,
            bx=b.x-cam;
        
        if(im.guard) {
            X.drawImage(im.guard, bx, b.y-20, b.w, b.h+20);
        }
        
        // Полоса здоровья
        X.fillStyle="#111";
        X.fillRect(bx,b.y-18,b.w,7);
        X.fillStyle="#ff4040";
        X.fillRect(bx,b.y-18,b.w*b.hp/3,7);
        X.fillStyle="#fff";
        X.font="bold 14px Arial";
        X.fillText("СТРАЖ",bx+42,b.y-27);
    }
    
    // Персонаж
    if(im.player) {
        X.save();
        if(P.inv&&Math.floor(P.inv/6)%2===0)X.globalAlpha=.4;
        if(P.dir<0){
            X.translate(P.x-cam+P.w/2,0);
            X.scale(-1,1);
            X.drawImage(im.player,-P.w/2,P.y-25,P.w,P.h);
        }else{
            X.drawImage(im.player,P.x-cam,P.y-25,P.w,P.h);
        }
        X.restore();
    }
}

function say(t){
    let m=document.getElementById("msg");
    m.textContent=t;
    m.style.opacity=1;
    msgT=100;
}

function loop(){
    update();
    draw();
    requestAnimationFrame(loop);
}

// Обработчики событий
document.querySelector("#start button").onclick=()=>{
    playing=true;
    document.getElementById("start").classList.add("hidden");
    load(1);
    say("НАЙДИ ВЫХОД ИЗ ЛАБОРАТОРИИ");
    AudioSystem.startBackgroundMusic();
};

document.querySelector("#complete button").onclick=()=>{
    document.getElementById("complete").classList.add("hidden");
    load(level+1);
    playing=true;
    say("УРОВЕНЬ "+level);
    AudioSystem.startBackgroundMusic();
};

document.querySelector("#finish button").onclick=()=>{
    totalChips=0;
    levels[0].chips=[[1250,550],[1600,450],[2750,450],[3250,220],[4350,520]];
    levels[1].chips=[[1250,520],[1600,400],[2800,500],[3400,230],[4950,400]];
    levels[2].chips=[[1100,520],[1500,400],[2500,420],[3000,150],[4750,380]];
    document.getElementById("finish").classList.add("hidden");
    load(1);
    playing=true;
    AudioSystem.startBackgroundMusic();
};

addEventListener("keydown",e=>{
    let k=e.key.toLowerCase();
    if(k==="a"||k==="arrowleft")keys.a=1;
    if(k==="d"||k==="arrowright")keys.d=1;
    if(k==="w"||k==="arrowup"){
        if(!keys.w)wp=1;
        keys.w=1;
    }
});

addEventListener("keyup",e=>{
    let k=e.key.toLowerCase();
    if(k==="a"||k==="arrowleft")keys.a=0;
    if(k==="d"||k==="arrowright")keys.d=0;
    if(k==="w"||k==="arrowup")keys.w=0;
});

// Инициализация
load(1);
loop();
</script>
</body>
</html>
